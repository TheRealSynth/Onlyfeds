# Public site URL (used for metadata, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=https://yardfame.com

# PayPal destination for Founding Supporter contributions.
# Not yet supplied. Contribution CTAs render a "checkout being finalized"
# state until this is set to a real PayPal.me link or hosted checkout URL.
NEXT_PUBLIC_PAYPAL_SUPPORT_URL=

# Public contact email shown in the footer and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=info@yardfame.com

# Supabase (server-side only, do not prefix with NEXT_PUBLIC_).
# Required for the waitlist and creator-interest forms to persist
# submissions. Without these, the forms still validate and respond
# successfully, but nothing is stored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
